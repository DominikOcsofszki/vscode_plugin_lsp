LSP_MODE=python
LSP_PACKAGE=bundled/my_dist/jsq_lsp-0.1.0-py3-none-any.whl
LSP_IMPORT_MODULE=jsq_lsp.main
LSP_SERVER_ATTRIBUTE=server
LSP_RUN_MODULE=jsq_lsp
LSP_PYTHON_COMMAND=python3
LSP_ID=jsqlsp
LSP_NAME=Python Language Server
LSP_LANGUAGE_IDS=python

# For a language server provided as an executable, use command mode instead:
# LSP_MODE=command
# LSP_COMMAND=path/to/language-server
# LSP_COMMAND_ARGS=["--stdio"]
# LSP_LANGUAGE_IDS=rust
# LSP_ID=rustls
# LSP_NAME=Rust Language Server
